#!/usr/bin/env bash
# Show server config as JSON
# USAGE: mcp show <name>
#
# COMPLETE:
#   1 _mcp_server_names

set -euo pipefail
SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
source "$SCRIPT_DIR/lib-cli.bash" --auto-help "$@"
source "$SCRIPT_DIR/lib-mcp.bash"

name="${1:-}"
[[ -z "$name" ]] && usage

cli_require_jq
ensure_file
jq -e ".\"$name\"" "$MCP_FILE" || { echo "Server '$name' not found"; exit 1; }
